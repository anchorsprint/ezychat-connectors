          "hint": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "ms": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "zh-CN": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              }
            },
            "required": [
              "en"
            ],
            "additionalProperties": false
          },
          "options": {
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "label": {
                  "type": "object",
                  "properties": {
                    "en": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "ms": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "zh-CN": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    }
                  },
                  "required": [
                    "en"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "value",
                "label"
              ],
              "additionalProperties": false
            }
          },
          "default": {},
          "from": {
            "type": "string",
            "maxLength": 64
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "type",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "vote": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "ms": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "zh-CN": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
