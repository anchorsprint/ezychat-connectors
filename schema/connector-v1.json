{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dl.ezychat.ai/connectors/schema/connector-v1.json",
  "title": "EzyChat connector entry (schemaVersion 1)",
  "description": "One entry of the EzyChat connector list. Generated from the app contract by scripts/connector-schema.mjs in ezychat-lite; do not edit by hand.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,48}$"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "minAppVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "mcp",
        "builtin",
        "coming_soon"
      ]
    },
    "editions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "lite",
          "enterprise"
        ]
      }
    },
    "builtinId": {
      "type": "string",
      "maxLength": 64
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "summary": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "ms": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "zh-CN": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      },
      "required": [
        "en"
      ],
      "additionalProperties": false
    },
    "description": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "ms": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "zh-CN": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      },
      "required": [
        "en"
      ],
      "additionalProperties": false
    },
    "category": {
      "type": "string",
      "enum": [
        "calendar",
        "accounting",
        "crm",
        "spreadsheets",
        "payments",
        "online_shop",
        "custom",
        "other"
      ]
    },
    "icon": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,48}\\.(svg|png)$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        }
      },
      "required": [
        "file",
        "sha256",
        "size"
      ],
      "additionalProperties": false
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "privacy": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "ms": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "zh-CN": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        }
      },
      "required": [
        "en"
      ],
      "additionalProperties": false
    },
    "mcp": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": false
    },
    "auth": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "oauth"
            },
            "clientId": {
              "type": "string",
              "maxLength": 300
            },
            "scopes": {
              "default": [],
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "oauth_own_app"
            },
            "scopes": {
              "default": [],
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            },
            "help": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "api_key"
            },
            "label": {
              "type": "object",
              "properties": {
                "en": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "ms": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "zh-CN": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              },
              "required": [
                "en"
              ],
              "additionalProperties": false
            },
            "help": {
              "type": "string",
              "format": "uri"
            },
            "header": {
              "default": {
                "name": "Authorization",
                "value": "Bearer {key}"
              },
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9-]{1,64}$"
                },
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              },
              "required": [
                "name",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "label"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "credentials"
            },
            "fields": {
              "minItems": 1,
              "maxItems": 6,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-zA-Z0-9]{0,39}$"
                  },
                  "label": {
                    "type": "object",
                    "properties": {
                      "en": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      },
                      "ms": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      },
                      "zh-CN": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      }
                    },
                    "required": [
                      "en"
                    ],
                    "additionalProperties": false
                  },
                  "hint": {
                    "type": "object",
                    "properties": {
                      "en": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 240
                      },
                      "ms": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 240
                      },
                      "zh-CN": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 240
                      }
                    },
                    "required": [
                      "en"
                    ],
                    "additionalProperties": false
                  },
                  "secret": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "id",
                  "label",
                  "secret"
                ],
                "additionalProperties": false
              }
            },
            "headers": {
              "minItems": 1,
              "maxItems": 6,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9-]{1,64}$"
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                },
                "required": [
                  "name",
                  "value"
                ],
                "additionalProperties": false
              }
            },
            "help": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "type",
            "fields",
            "headers"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ]
    },
    "tools": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.-]{1,64}$"
          },
          "title": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "ms": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "zh-CN": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              }
            },
            "required": [
              "en"
            ],
            "additionalProperties": false
          },
          "description": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "ms": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "zh-CN": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              }
            },
            "required": [
              "en"
            ],
            "additionalProperties": false
          },
          "instructions": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "ms": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "zh-CN": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "en"
            ],
            "additionalProperties": false
          },
          "access": {
            "type": "string",
            "enum": [
              "read",
              "write"
            ]
          },
          "guards": {
            "type": "object",
            "properties": {
              "confirmFirst": {
                "type": "boolean"
              },
              "valueFrom": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*(\\.[a-zA-Z_][a-zA-Z0-9_]*)*$"
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              },
              "fromCustomer": {
                "maxItems": 10,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*(\\.[a-zA-Z_][a-zA-Z0-9_]*)*$"
                }
              },
              "within": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*(\\.[a-zA-Z_][a-zA-Z0-9_]*)*$"
                },
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[a-z][a-zA-Z0-9]{0,39}$"
                }
              },
              "limits": {
                "type": "object",
                "properties": {
                  "perChat": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  },
                  "perDay": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "name",
          "title",
          "description",
          "access"
        ],
        "additionalProperties": false
      }
    },
    "skill": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        },
        "ms": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        },
        "zh-CN": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        }
      },
      "required": [
        "en"
      ],
      "additionalProperties": false
    },
    "settings": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9]{0,39}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "number",
              "select",
              "toggle",
              "days",
              "timeRange",
              "calendarPicker"
            ]
          },
          "label": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "ms": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "zh-CN": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "required": [
              "en"
            ],
            "additionalProperties": false
